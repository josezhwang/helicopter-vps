# PostgreSQL connection (the role must own the database — see README)
DATABASE_URL=postgresql://aerium:replace-this-password@localhost:5432/aerium
# Database on another machine: use its IP and SSL. `no-verify` encrypts the connection but
# accepts the self-signed certificate PostgreSQL ships with (`require` rejects it).
# DATABASE_URL=postgresql://aerium:replace-this-password@203.0.113.10:5432/aerium?sslmode=no-verify

# Required. Use a long random value, e.g. `openssl rand -hex 48`
JWT_SECRET=replace-this-with-a-long-random-secret

# HTTP port (default 3002)
PORT=3002

# Optional: only let these site origins call the API (comma-separated, localhost always allowed). Empty = any origin.
CORS_ORIGINS=

# Optional: post new battles (with a join link), battle starts, killing sprees and results to a Discord channel.
# In Discord: channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# Optional: the address players open the game at (used for the join links in Discord), e.g. http://203.0.113.10:5173
PUBLIC_SITE_URL=
